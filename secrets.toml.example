# Copie este archivo como .streamlit/secrets.toml (en local) o pegue su
# contenido en Streamlit Cloud → App → Settings → Secrets.
# Si NO existe secrets.toml, la app usa SQLite local automáticamente.

[google_sheets]
# Lo que aparece en la URL de la planilla: docs.google.com/spreadsheets/d/ESTO/edit
spreadsheet_key = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# Pegue aquí los campos del JSON de la cuenta de servicio de Google Cloud
[gcp_service_account]
type = "service_account"
project_id = "willy-gas"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
client_email = "willy-gas@willy-gas.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/willy-gas%40willy-gas.iam.gserviceaccount.com"

# Opcional: candado. La app solo abre con  https://SU-APP.streamlit.app/?k=ESTA_CLAVE
[acceso]
clave = "cambie-esto-por-algo-largo-y-secreto"
